#mods {
    height: 1fr;
}

#filter {
    height: 1;
    border: none;
    padding: 0 1;
    background: $boost;
}

#downloads {
    height: auto;
    max-height: 6;
    padding: 0 1;
    background: $boost;
}

DownloadRow {
    height: 1;
}

DownloadRow Label {
    width: 45;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

DownloadRow ProgressBar {
    width: 1fr;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

ModalScreen {
    align: center middle;
}

.dialog {
    width: 70;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.dialog.wide {
    width: 110;
}

.dialog.tall {
    height: 90%;
}

.dialog .title {
    text-style: bold;
    margin-bottom: 1;
}

.dialog .section {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

.dialog .hint {
    color: $text-muted;
    margin-top: 1;
}

#files {
    height: auto;
    max-height: 16;
    margin-top: 1;
}

#conflicts {
    height: 1fr;
}

#targets {
    height: 1fr;
}

#work-detail {
    margin-top: 1;
    color: $text-muted;
}

#report {
    height: 1fr;
}

#option-keys {
    height: auto;
    max-height: 24;
}

#groups {
    height: auto;
    max-height: 10;
    margin-top: 1;
}

#filter {
    margin-top: 1;
}

#preset {
    margin-top: 1;
    color: $warning;
}

#ops {
    height: auto;
    max-height: 8;
    margin-top: 1;
    color: $text-muted;
}
